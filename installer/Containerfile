# NidaOS installer image (milestone M-07, decisions D12, D32 and D33).
#
# image-builder makes a bootable ISO from this container (image type
# generic-iso). The ISO starts this container as a live system. The live
# system runs nida-installer and shows its page in full screen with a
# kiosk browser. nida-installer makes the partitions and installs the
# NidaOS image with "bootc install to-filesystem". image-builder puts the
# NidaOS image (the payload) in /var/lib/containers/storage of the ISO.
#
# Build it with the source of the core service and of the console:
#   podman build --build-context core=core --build-context console=console \
#       --build-arg PAYLOAD_REF=... -f installer/Containerfile installer

# The installer page: the entry installer.html of the console project.
FROM docker.io/library/node:24 AS ui-build
WORKDIR /src
COPY --from=console package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY --from=console . .
RUN npm run typecheck && npx vitest run && npx vite build --config vite.installer.config.ts --outDir /out/dist --emptyOutDir

# nida-installer, a static program.
FROM docker.io/library/golang:1.26 AS installer-build
ARG NIDAOS_BUILD=dev
WORKDIR /src
COPY --from=core . .
COPY --from=ui-build /out/dist/ ./internal/installerui/dist/
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath \
        -ldflags "-s -w -X github.com/fathorMB/NidaOS/core/internal/version.Version=${NIDAOS_BUILD}" \
        -o /out/nida-installer ./cmd/nida-installer

FROM quay.io/fedora/fedora-bootc:45

# The reference of the NidaOS image that the installer installs.
ARG PAYLOAD_REF=ghcr.io/fathormb/nidaos:proof

# The tools of the ISO (image-builder generic-iso), of the disks, and of
# the kiosk screen. No Anaconda (decision D33).
RUN dnf5 install -qy \
    dracut-live \
    grub2-efi-x64-cdboot \
    grub2-pc-modules \
    isomd5sum \
    xorrisofs \
    squashfs-tools \
    gdisk \
    parted \
    dosfstools \
    xfsprogs \
    e2fsprogs \
    cage \
    cog \
    mesa-dri-drivers \
    default-fonts-core-sans \
    default-fonts-other-sans && \
    dnf5 clean all

RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

COPY rootfs/ /
COPY --from=installer-build /out/nida-installer /usr/bin/nida-installer

RUN mkdir -p /usr/share/nidaos && echo "${PAYLOAD_REF}" > /usr/share/nidaos/payload-ref && \
    systemctl enable nida-installer.service nida-kiosk.service && \
    systemctl set-default graphical.target

# Services of an installed bootc system that have no use on the media.
RUN for unit in bootloader-update.service bootc-fetch-apply-updates.timer \
        rpm-ostree-fix-shadow-mode.service bootc-generic-growpart.service; do \
        systemctl mask "$unit" || true; \
    done

# The initramfs starts the live system from the squashfs file of the ISO
# (dmsquash-live, see /usr/lib/dracut/dracut.conf.d/40-nidaos-iso.conf).
RUN kernel=$(ls /usr/lib/modules) && \
    DRACUT_NO_XATTR=1 dracut --force --zstd --reproducible --no-hostonly \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}" && \
    lsinitrd "/usr/lib/modules/${kernel}/initramfs.img" | grep -q dmsquash-live
