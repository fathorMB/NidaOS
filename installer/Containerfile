# NidaOS installer image (feasibility proof, milestone M-01).
#
# image-builder makes a bootable ISO from this container (image type
# bootc-generic-iso). The ISO starts Anaconda. Anaconda installs the NidaOS
# image, which image-builder puts in the container storage of the ISO.
#
# Source of the Anaconda setup: the image-builder guide
# "Generating a Fedora 45 Live ISO with Anaconda for bootc Image Installation".
FROM quay.io/fedora/fedora-bootc:45

# The reference of the NidaOS image that the installer installs.
ARG PAYLOAD_REF=ghcr.io/fathormb/nidaos:proof

# Installer tools and boot media tools.
RUN dnf5 install -qy \
    anaconda \
    anaconda-install-img-deps \
    anaconda-dracut \
    dracut-config-generic \
    dracut-network \
    net-tools \
    grub2-efi-x64-cdboot \
    plymouth \
    default-fonts-core-sans \
    default-fonts-other-sans \
    xorrisofs \
    squashfs-tools \
    jq && \
    dnf5 clean all

RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# The boot menu, the NidaOS kickstart and the disk plan script.
COPY rootfs/ /
RUN chmod 0755 /usr/libexec/nidaos/nida-plan.sh && \
    sed -i "s|@@PAYLOAD_REF@@|${PAYLOAD_REF}|g" /usr/share/nidaos/install.ks && \
    ! grep -q '@@' /usr/share/nidaos/install.ks && \
    cp /usr/share/nidaos/install.ks /usr/share/anaconda/interactive-defaults.ks

# Changes that Anaconda needs in this environment.
RUN echo "install:x:0:0:root:/root:/usr/libexec/anaconda/run-anaconda" >> /etc/passwd && \
    echo "install::14438:0:99999:7:::" >> /etc/shadow && \
    passwd -d root
RUN mv /usr/share/anaconda/list-harddrives-stub /usr/bin/list-harddrives && \
    mv /usr/share/dnf5/repos.d /etc/anaconda.repos.d && \
    ln -s /lib/systemd/system/anaconda.target /etc/systemd/system/default.target && \
    rm -v /usr/lib/systemd/system-generators/systemd-gpt-auto-generator
RUN ln -s /usr/lib/systemd/system/anaconda-shell@.service /usr/lib/systemd/system/autovt@.service

# The initramfs contains the kickstart as /nida.ks. The boot menu gives
# inst.ks=file:/nida.ks, thus the installation is automatic.
RUN mkdir -p "$(realpath /root)" && \
    kernel=$(kernel-install list --json pretty | jq -r '.[] | select(.has_kernel == true) | .version') && \
    DRACUT_NO_XATTR=1 dracut --force -v --zstd --reproducible --no-hostonly \
        --add "anaconda" \
        --include /usr/share/nidaos/install.ks /nida.ks \
        "/usr/lib/modules/${kernel}/initramfs.img" "${kernel}"
