[Unit]
Description=The NidaOS installer in full screen (decision D32)
After=nida-installer.service systemd-user-sessions.service
Wants=nida-installer.service
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal+console
StandardError=journal+console
UtmpIdentifier=tty1
UtmpMode=user
# cage shows one program in full screen. cog is a small browser (WPE
# WebKit). The page waits for the installer itself.
ExecStart=/usr/bin/cage -s -- /usr/bin/cog --platform=wl http://127.0.0.1/
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
