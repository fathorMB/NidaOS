[Unit]
Description=Lightweight Kubernetes (k3s) for the NidaOS private cloud
Documentation=https://k3s.io
Wants=network-online.target
After=network-online.target

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
EnvironmentFile=-/etc/sysconfig/%N
KillMode=process
Delegate=yes
User=root
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
# /var is not part of the image. Copy the NidaOS manifests at each start,
# thus an image update also updates them.
ExecStartPre=/usr/bin/install -D -m 0600 /usr/share/nidaos/k3s/nida-storage.yaml /var/lib/rancher/k3s/server/manifests/nida-storage.yaml
ExecStartPre=/usr/bin/install -D -m 0600 /usr/share/nidaos/k3s/nida-registry.yaml /var/lib/rancher/k3s/server/manifests/nida-registry.yaml
ExecStart=/usr/bin/k3s server
